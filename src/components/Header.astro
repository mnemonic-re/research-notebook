---
const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navItems = [
  { name: 'Research', href: `${base}research/` },
  { name: 'Security Feed', href: `${base}feed/`, isDropdown: true },
  { name: 'Tools', href: `${base}tools/` },
  { name: 'Notes', href: `${base}notes/` },
  { name: 'Tags', href: `${base}tags/` },
  { name: 'Links', href: `${base}links/` },
  { name: 'About', href: `${base}about/` },
  { name: 'Contact', href: `${base}contact/` },
];
---

<header class="header">
  <div class="container header-content">
    <a href={base} class="site-title">
      <span class="prompt-prefix">sec@research:~$</span> blog
    </a>
    <nav class="nav">
      {navItems.map((item) => {
        const isFeed = item.isDropdown;
        const isActive = !isFeed && (pathname === item.href || (item.href !== base && pathname.startsWith(item.href)));
        const isFeedActive = isFeed && pathname.includes('/feed');

        if (isFeed) {
          return (
            <div class="nav-dropdown">
              <a href={item.href} class={isFeedActive ? 'nav-link active dropdown-toggle' : 'nav-link dropdown-toggle'}>
                {item.name} <span class="caret">▾</span>
              </a>
              <div class="dropdown-menu">
                <a 
                  href={`${base}feed/`} 
                  class={pathname === `${base}feed/` || pathname === `${base}feed` ? 'dropdown-item active' : 'dropdown-item'}
                >
                  💻 OS Security Feed
                </a>
                <a 
                  href={`${base}feed/web/`} 
                  class={pathname.includes('/feed/web') ? 'dropdown-item active' : 'dropdown-item'}
                >
                  🌐 Web Security Feed
                </a>
                <a 
                  href={`${base}feed/critical/`} 
                  class={pathname.includes('/feed/critical') ? 'dropdown-item active item-critical' : 'dropdown-item item-critical'}
                >
                  🚨 Critical Zero-Days
                </a>
              </div>
            </div>
          );
        }

        return (
          <a href={item.href} class={isActive ? 'nav-link active' : 'nav-link'}>
            {item.name}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 0;
    background-color: var(--bg-secondary);
    position: relative;
    z-index: 100;
  }
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .site-title {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-heading);
  }
  .site-title:hover {
    text-decoration: none;
  }
  .prompt-prefix {
    color: var(--accent-color);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .nav-link {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--accent-color);
    text-decoration: none;
  }

  /* Dropdown Styles */
  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .caret {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .caret {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.4rem 0;
    min-width: 230px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: all 0.18s ease;
    margin-top: 0.4rem;
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    margin-top: 0.2rem;
  }

  .dropdown-item {
    display: block;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .dropdown-item:hover {
    background-color: var(--bg-tertiary);
    color: var(--accent-color);
    text-decoration: none;
  }

  .dropdown-item.active {
    color: var(--accent-color);
    font-weight: 600;
    background-color: rgba(88, 166, 255, 0.1);
  }

  .item-critical:hover {
    color: #f85149 !important;
    background-color: rgba(248, 81, 73, 0.12) !important;
  }

  .item-critical.active {
    color: #f85149 !important;
    background-color: rgba(248, 81, 73, 0.15) !important;
  }
</style>

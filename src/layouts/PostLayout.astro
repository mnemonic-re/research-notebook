---
import BaseLayout from './BaseLayout.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  category?: string;
  image?: string;
  rawContent?: string;
}

const { title, description, date, tags = [], category, image, rawContent = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingTime = rawContent ? getReadingTime(rawContent) : '';
---

<BaseLayout title={`${title} | Research Notebook`} description={description} image={image} type="article">
  <article class="post-article">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
        {readingTime && <span class="meta-separator">•</span>}
        {readingTime && <span>{readingTime}</span>}
        {category && <span class="meta-separator">•</span>}
        {category && <a href={`${base}categories/${category.toLowerCase().replace(/\s+/g, '-')}/`} class="category-link">{category}</a>}
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`${base}tags/${tag.toLowerCase()}/`} class="tag-badge">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>

  <!-- Lightbox Modal for Enlarging Screenshots -->
  <div id="screenshot-lightbox" class="lightbox-overlay" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close-btn" aria-label="Close enlarged screenshot">&times;</button>
    <div class="lightbox-inner">
      <img id="lightbox-image" src="" alt="Enlarged screenshot" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Attach Copy Buttons to all code blocks
    const preBlocks = document.querySelectorAll('.post-content pre');
    preBlocks.forEach((pre) => {
      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-code-btn';
      copyBtn.setAttribute('type', 'button');
      copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
      copyBtn.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>Copy</span>
      `;

      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const codeEl = pre.querySelector('code');
        const textToCopy = codeEl ? codeEl.innerText : (pre as HTMLElement).innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Copied!</span>
          `;
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = `
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy</span>
            `;
          }, 2000);
        } catch (err) {
          console.error('Copy failed:', err);
        }
      });

      pre.appendChild(copyBtn);
    });

    // 2. x64dbg Assembly Custom Syntax Highlighting
    const asmBlocks = document.querySelectorAll('.post-content pre[data-language="asm"], .post-content pre[data-language="x64asm"], .post-content pre[data-language="nasm"], .post-content pre[data-language="masm"], .post-content pre[data-language="assembly"], .post-content pre code[class*="language-asm"], .post-content pre code[class*="language-x64asm"]');
    
    const registersRegex = /^(RAX|RBX|RCX|RDX|RSI|RDI|RBP|RSP|R8|R9|R10|R11|R12|R13|R14|R15|EAX|EBX|ECX|EDX|ESI|EDI|EBP|ESP|AX|BX|CX|DX|AL|BL|CL|DL|R8D|R9D|R10D|R11D|R12D|R13D|R14D|R15D|R8W|R9W|R10W|R11W|R12W|R13W|R14W|R15W|R8B|R9B|R10B|R11B|R12B|R13B|R14B|R15B|DI|SI|BP|SP)$/i;

    const escapeHtml = (str: string) => str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    asmBlocks.forEach((block) => {
      const preEl = block.tagName.toLowerCase() === 'pre' ? block as HTMLPreElement : block.closest('pre');
      const codeEl = block.tagName.toLowerCase() === 'code' ? block as HTMLElement : (block.querySelector('code') || block) as HTMLElement;

      if (preEl) {
        preEl.style.backgroundColor = '#161616';
        preEl.style.borderColor = '#333333';
      }

      const rawText = codeEl.innerText || codeEl.textContent || '';
      const lines = rawText.split('\n');

      const highlightedLines = lines.map(line => {
        if (!line.trim()) return line;

        let commentIdx = line.indexOf(';');
        let codePart = commentIdx !== -1 ? line.substring(0, commentIdx) : line;
        let commentPart = commentIdx !== -1 ? `<span style="color: #A6E22E; font-style: italic;">${escapeHtml(line.substring(commentIdx))}</span>` : '';

        const tokenRegex = /(\s+)|(\b(?:QWORD|DWORD|WORD|BYTE)\s+PTR\b)|(\b(?:SS|DS|CS|ES|FS|GS):)|(\[|\])|(0x[0-9a-fA-F]+|[0-9A-Fa-f]{4,16}h|\b\d+\b)|([a-zA-Z0-9_]+)|([^\s\w]+)/gi;

        let match;
        let isFirstWord = true;
        let html = '';

        while ((match = tokenRegex.exec(codePart)) !== null) {
          const [full, whitespace, ptrSize, segPrefix, bracket, number, word, punct] = match;

          if (whitespace) {
            html += whitespace;
          } else if (ptrSize) {
            html += `<span style="color: #FFFBF0; font-weight: 600;">${escapeHtml(ptrSize)}</span>`;
          } else if (segPrefix) {
            html += `<span style="color: #00AA61; font-weight: bold;">${escapeHtml(segPrefix)}</span>`;
          } else if (bracket) {
            html += `<span style="color: #00AA61; font-weight: bold;">${escapeHtml(bracket)}</span>`;
          } else if (number) {
            html += `<span style="color: #F27709;">${escapeHtml(number)}</span>`;
          } else if (word) {
            const uWord = word.toUpperCase();
            if (isFirstWord) {
              isFirstWord = false;
              let color = '#FFFBF0'; // Default cream/white for MOV, LEA, SUB, XOR, AND, etc.
              let weight = '600';

              if (uWord === 'CALL') {
                color = '#00FFFF'; // Cyan
                weight = 'bold';
              } else if (['JE', 'JNE', 'JZ', 'JNZ', 'JA', 'JAE', 'JB', 'JBE', 'JG', 'JGE', 'JL', 'JLE', 'JS', 'JNS', 'TEST', 'CMP'].includes(uWord)) {
                color = '#FF0000'; // Bright Red
                weight = 'bold';
              } else if (uWord === 'JMP') {
                color = '#FF00FF'; // Fuchsia / Magenta
                weight = 'bold';
              } else if (['PUSH', 'POP', 'RET', 'RETN'].includes(uWord)) {
                color = '#FFFF00'; // Yellow
                weight = 'bold';
              } else if (['NOP', 'INT3'].includes(uWord)) {
                color = '#A8A8A8'; // Gray
                weight = 'normal';
              }

              html += `<span style="color: ${color}; font-weight: ${weight};">${escapeHtml(word)}</span>`;
            } else if (registersRegex.test(word)) {
              html += `<span style="color: #55AAFF;">${escapeHtml(word)}</span>`;
            } else {
              html += escapeHtml(word);
            }
          } else if (punct) {
            html += escapeHtml(punct);
          }
        }

        return html + commentPart;
      });

      codeEl.innerHTML = highlightedLines.join('\n');
    });

    // 3. Lightbox setup
    const lightbox = document.getElementById('screenshot-lightbox');
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');

    if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

    const images = document.querySelectorAll('.post-content img');

    images.forEach((img) => {
      const imageEl = img as HTMLImageElement;
      imageEl.style.cursor = 'zoom-in';

      imageEl.addEventListener('click', (e) => {
        e.stopPropagation();
        lightboxImg.src = imageEl.src;
        lightboxImg.alt = imageEl.alt || 'Enlarged screenshot';

        const captionText = imageEl.alt || imageEl.getAttribute('title') || '';
        lightboxCaption.textContent = captionText;

        lightbox.classList.add('active');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });

    const closeLightbox = () => {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === closeBtn) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('active')) {
        closeLightbox();
      }
    });
  });
</script>

<style>
  .post-article {
    max-width: 760px;
    margin: 0 auto;
  }
  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }
  .post-title {
    margin-bottom: 0.5rem;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .meta-separator {
    margin: 0 0.4rem;
  }
  .category-link {
    color: var(--text-muted);
  }
  .category-link:hover {
    color: var(--accent-color);
  }
  .post-tags {
    margin-top: 0.5rem;
  }
  .post-content {
    line-height: 1.7;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    margin: 1.5rem auto;
    display: block;
    cursor: zoom-in;
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .post-content :global(img:hover) {
    border-color: var(--accent-color);
  }

  /* Lightbox Modal CSS */
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 14, 20, 0.92);
    backdrop-filter: blur(6px);
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-close-btn {
    position: absolute;
    top: 20px;
    right: 25px;
    background: rgba(255, 255, 255, 0.12);
    color: #f0f6fc;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 2rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10001;
  }
  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }
  .lightbox-inner {
    max-width: 92vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .lightbox-inner img {
    max-width: 90vw;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.85);
    border: 1px solid var(--border-color);
  }
  .lightbox-caption {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-top: 0.8rem;
    text-align: center;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const publishedPosts = await getPublishedPosts();
  const categoriesMap = new Map<string, string>();

  publishedPosts.forEach((post) => {
    const cat = post.data.category || 'General';
    categoriesMap.set(cat.toLowerCase().replace(/\s+/g, '-'), cat);
  });

  return Array.from(categoriesMap.entries()).map(([catKey, originalCat]) => {
    const filteredPosts = publishedPosts.filter(
      (post) => (post.data.category || 'General').toLowerCase().replace(/\s+/g, '-') === catKey
    );
    return {
      params: { category: catKey },
      props: { categoryName: originalCat, posts: filteredPosts },
    };
  });
}

const { categoryName, posts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${categoryName} Research | Cybersecurity Research Notebook`}>
  <div class="page-header">
    <h1>Category: <span class="category-highlight">{categoryName}</span></h1>
    <p>Found {posts.length} {posts.length === 1 ? 'article' : 'articles'}.</p>
  </div>

  <div class="post-list">
    {posts.map((post) => (
      <article class="post-card">
        <time class="post-date">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        <h2 class="post-card-title">
          <a href={`${base}research/${post.slug}/`}>{post.data.title}</a>
        </h2>
        <p class="post-card-desc">{post.data.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }
  .category-highlight {
    color: var(--accent-color);
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .post-card-title {
    font-size: 1.3rem;
    margin-top: 0.2rem;
    margin-bottom: 0.4rem;
    border: none;
    padding: 0;
  }
  .post-card-desc {
    color: var(--text-primary);
    font-size: 0.95rem;
  }
</style>

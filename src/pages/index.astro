---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const allPublished = await getPublishedPosts();
const recentPosts = allPublished.slice(0, 5);
---

<BaseLayout title="Cybersecurity Research Notebook">
  <section class="hero-section">
    <h1 class="hero-title">Cybersecurity Research Notebook</h1>
    <p class="hero-subtitle">
      Technical notes on Windows internals, kernel driver analysis, reverse engineering, WinDbg debugging, and LLM-assisted vulnerability research.
    </p>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Recent Research Articles</h2>
      <a href={`${base}research/`} class="view-all">View all &rarr;</a>
    </div>

    {recentPosts.length === 0 ? (
      <p class="empty-state">No research articles published yet.</p>
    ) : (
      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-card">
            <time class="post-date">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <h3 class="post-card-title">
              <a href={`${base}research/${post.slug}/`}>{post.data.title}</a>
            </h3>
            <p class="post-card-desc">{post.data.description}</p>
            <div class="post-card-tags">
              {post.data.tags.map((tag) => (
                <a href={`${base}tags/${tag.toLowerCase()}/`} class="tag-badge">#{tag}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="section grid-section">
    <div class="card">
      <h3>Tools & Experiments</h3>
      <p>Custom tools, scripts, and utilities developed during vulnerability research.</p>
      <a href={`${base}tools/`}>Explore tools &rarr;</a>
    </div>

    <div class="card">
      <h3>Quick Notes</h3>
      <p>Short technical snippets, WinDbg commands, and temporary analysis observations.</p>
      <a href={`${base}notes/`}>Read notes &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 2rem 0 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
  }
  .hero-title {
    font-size: 2.2rem;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }
  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 680px;
  }
  .section {
    margin-bottom: 2.5rem;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }
  .view-all {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .post-card-title {
    margin-top: 0.2rem;
    margin-bottom: 0.4rem;
  }
  .post-card-desc {
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }
  .grid-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
  }
  .card h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .card p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
</style>

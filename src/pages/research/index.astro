---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posts = await getPublishedPosts();
---

<BaseLayout title="Research Articles | Cybersecurity Research Notebook">
  <div class="page-header">
    <h1>Research Articles</h1>
    <p>Technical writeups, disassembly breakdowns, and kernel debugging notes.</p>
  </div>

  <div class="post-list">
    {posts.map((post) => (
      <article class="post-card">
        <time class="post-date">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        <h2 class="post-card-title">
          <a href={`${base}research/${post.slug}/`}>{post.data.title}</a>
        </h2>
        <p class="post-card-desc">{post.data.description}</p>
        <div class="post-card-tags">
          {post.data.tags.map((tag) => (
            <a href={`${base}tags/${tag.toLowerCase()}/`} class="tag-badge">#{tag}</a>
          ))}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .post-card-title {
    font-size: 1.3rem;
    margin-top: 0.2rem;
    margin-bottom: 0.4rem;
    border: none;
    padding: 0;
  }
  .post-card-desc {
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import toolsData from '../../data/tools.json';

interface ToolLink {
  label: string;
  url: string;
}

interface ToolItem {
  id: string;
  name: string;
  status: string;
  category?: string;
  description: string;
  note?: string;
  links?: ToolLink[];
  screenshots?: string[];
}

const tools: ToolItem[] = toolsData || [];

// Calculate stats
const releasedCount = tools.filter(t => (t.status || '').toLowerCase() === 'released').length;
const devCount = tools.filter(t => (t.status || '').toLowerCase() === 'in development').length;

// Extract unique category tags across tools
const allCategories = Array.from(new Set(
  tools.flatMap(t => t.category ? t.category.split(',').map(c => c.trim()) : [])
)).filter(Boolean);

function getStatusClass(status: string) {
  switch ((status || '').toLowerCase()) {
    case 'released':
      return 'status-released';
    case 'in development':
      return 'status-dev';
    default:
      return 'status-placeholder';
  }
}
---

<BaseLayout title="Tools & Utilities | Cybersecurity Research Notebook">
  <div class="page-header">
    <div class="header-content-wrapper">
      <div>
        <h1>Tools & Utilities</h1>
        <p>Open-source tools, debug extensions, and MCP automation servers developed during security research.</p>
      </div>
      <div class="tools-stats-bar">
        <div class="stat-pill">
          <span class="stat-num">{tools.length}</span>
          <span class="stat-label">Total Tools</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num text-dev">{devCount}</span>
          <span class="stat-label">In Dev</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num text-released">{releasedCount}</span>
          <span class="stat-label">Released</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Category Filter Section -->
  <div class="tools-control-bar">
    <div class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="tools-search-input" 
        placeholder="Filter tools by keyword or tag (e.g. WinDbg, MCP, Debugging)..." 
        autocomplete="off"
      />
    </div>

    <div class="category-pills">
      <button class="pill-btn active" data-category="all">All</button>
      {allCategories.map(cat => (
        <button class="pill-btn" data-category={cat}>{cat}</button>
      ))}
    </div>
  </div>

  <div class="tools-grid" id="tools-list">
    {tools.length === 0 ? (
      <p class="empty-state">No tools listed yet.</p>
    ) : (
      tools.map((tool) => {
        const mainLink = (tool.links && tool.links.length > 0) ? tool.links[0].url : undefined;
        const categories = tool.category ? tool.category.split(',').map(c => c.trim()) : [];
        
        return (
          <article 
            class={`tool-card ${getStatusClass(tool.status)}`} 
            id={tool.id}
            data-title={tool.name.toLowerCase()}
            data-category={tool.category ? tool.category.toLowerCase() : ''}
            data-desc={tool.description.toLowerCase()}
          >
            <div class="tool-card-header">
              <div class="tool-title-group">
                <div class="tool-icon">🛠️</div>
                <div>
                  {mainLink ? (
                    <a href={mainLink} target={mainLink.startsWith('http') ? '_blank' : '_self'} rel="noopener noreferrer" class="tool-title-link">
                      <h2 class="tool-title">{tool.name}</h2>
                    </a>
                  ) : (
                    <h2 class="tool-title">{tool.name}</h2>
                  )}
                </div>
              </div>

              <div class="status-badge-container">
                <span class={`status-badge ${getStatusClass(tool.status)}`}>
                  <span class="status-dot"></span>
                  {tool.status}
                </span>
              </div>
            </div>

            <!-- Categories tags -->
            {categories.length > 0 && (
              <div class="tool-tags">
                {categories.map(cat => (
                  <span class="tool-tag-pill">#{cat}</span>
                ))}
              </div>
            )}

            <div class="tool-body">
              <p class="tool-desc">{tool.description}</p>
            </div>

            {tool.note && (
              <div class="tool-note-box">
                <span class="note-icon">💡</span>
                <span>{tool.note}</span>
              </div>
            )}

            <div class="tool-card-footer">
              {tool.links && tool.links.length > 0 && (
                <div class="tool-links">
                  {tool.links.map((link) => (
                    <a href={link.url} target={link.url.startsWith('http') ? '_blank' : '_self'} rel="noopener noreferrer" class="tool-btn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                      </svg>
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
      })
    )}

    <!-- Empty Search State -->
    <div id="no-tools-results" class="no-results-card" style="display: none;">
      <div class="no-results-icon">🔍</div>
      <h3>No tools matching your query</h3>
      <p>Try filtering by <code>WinDbg</code>, <code>MCP</code>, or <code>Debugging</code>.</p>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('tools-search-input');
      const categoryBtns = document.querySelectorAll('.pill-btn');
      const toolCards = document.querySelectorAll('.tool-card');
      const noResultsEl = document.getElementById('no-tools-results');

      if (!searchInput) return;

      let activeCategory = 'all';

      searchInput.addEventListener('input', applyFilters);

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.getAttribute('data-category');
          applyFilters();
        });
      });

      function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        toolCards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const category = card.getAttribute('data-category') || '';
          const desc = card.getAttribute('data-desc') || '';

          const matchesCat = activeCategory === 'all' || category.includes(activeCategory.toLowerCase());
          const matchesQuery = !query || title.includes(query) || category.includes(query) || desc.includes(query);

          if (matchesCat && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          noResultsEl.style.display = 'block';
        } else {
          noResultsEl.style.display = 'none';
        }
      }
    });
  </script>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-content-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    margin-bottom: 0.3rem;
  }

  .page-header p {
    color: var(--text-muted);
    margin: 0;
    max-width: 650px;
  }

  /* Stats Pills Bar */
  .tools-stats-bar {
    display: flex;
    gap: 0.75rem;
  }

  .stat-pill {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-heading);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 0.2rem;
  }

  .text-dev { color: #d29922; }
  .text-released { color: #3fb950; }

  /* Control Bar */
  .tools-control-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .search-input-wrapper {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  #tools-search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.6rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-heading);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  #tools-search-input:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.15);
  }

  .category-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pill-btn:hover {
    color: var(--text-heading);
    border-color: var(--text-muted);
  }

  .pill-btn.active {
    background-color: rgba(88, 166, 255, 0.15);
    color: var(--accent-color);
    border-color: var(--accent-color);
    font-weight: 600;
  }

  /* Tools Cards List */
  .tools-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tool-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-card:hover {
    border-color: var(--accent-color);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }

  .tool-card.status-dev {
    border-left: 4px solid #d29922;
  }

  .tool-card.status-released {
    border-left: 4px solid #3fb950;
  }

  .tool-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .tool-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tool-icon {
    font-size: 1.5rem;
    line-height: 1;
    background-color: var(--bg-tertiary);
    padding: 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }

  .tool-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-heading);
    transition: color 0.15s ease;
  }

  .tool-title-link {
    text-decoration: none;
    color: inherit;
  }

  .tool-title-link:hover .tool-title {
    color: var(--accent-color);
  }

  /* Live Pulsing Status Badge */
  .status-badge-container {
    flex-shrink: 0;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .status-badge.status-dev {
    background-color: rgba(210, 153, 34, 0.12);
    color: #d29922;
    border: 1px solid rgba(210, 153, 34, 0.35);
  }

  .status-badge.status-dev .status-dot {
    background-color: #d29922;
    box-shadow: 0 0 8px #d29922;
  }

  .status-badge.status-released {
    background-color: rgba(63, 185, 80, 0.12);
    color: #3fb950;
    border: 1px solid rgba(63, 185, 80, 0.35);
  }

  .status-badge.status-released .status-dot {
    background-color: #3fb950;
    box-shadow: 0 0 8px #3fb950;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    animation: statusPulse 2s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* Tool Tags */
  .tool-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tool-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background-color: var(--bg-tertiary);
    color: var(--accent-color);
    border: 1px solid var(--border-color);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
  }

  .tool-desc {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0;
  }

  /* Callout Note Box */
  .tool-note-box {
    background-color: rgba(88, 166, 255, 0.08);
    border: 1px solid rgba(88, 166, 255, 0.25);
    border-left: 3px solid var(--accent-color);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .note-icon {
    font-size: 1rem;
  }

  /* Button styling */
  .tool-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: 0.25rem;
  }

  .tool-links {
    display: flex;
    gap: 0.75rem;
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    background-color: var(--bg-tertiary);
    color: var(--accent-color);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .tool-btn:hover {
    border-color: var(--accent-color);
    background-color: rgba(88, 166, 255, 0.12);
    color: var(--accent-hover);
    text-decoration: none;
  }

  .no-results-card {
    background-color: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }

  .no-results-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }
</style>

